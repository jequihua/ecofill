{
  "datasets": {
    "davis_weather": {
      "uri": "/inputs/davis_weather_combined_s2_filt.parquet",
      "cadence": "1h",
      "group_by": "station_id",
      "key": "primary_key",
      "select": ["RBRL-COL-01"],
      "interval": ["2026-01-01T00:00:00Z", "2026-03-01T00:00:00Z"],
      "validity": ["2026-01-01T00:00:00Z", "2026-03-01T00:00:00Z"],
      "targets": ["bar"],
      "method": "RF-X",
      "max_gap": "48h",
      "predictors": ["temp_out", "humidity"],
      "parameters": {
        "n_estimators": 128, "max_depth": 12, "min_samples_leaf": 5, "seed": 0,
        "n_jobs": 1, "window_days": 180, "min_rows": 168, "max_rows": 4096
      }
    }
  },
  "output": {"uri": "/output/rf", "format": "parquet", "publication": "single_writer"},
  "limits": {
    "max_gaps": 3000, "max_method_calls": 2000, "max_rows_per_series": 400000,
    "wall_seconds": 600, "memory_bytes": 4294967296,
    "scratch_bytes": 268435456, "output_bytes": 1073741824
  }
}
